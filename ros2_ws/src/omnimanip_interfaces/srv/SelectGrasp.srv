# Stage 15: AnyGrasp proposals filtered by the heatmap of the VLM grasp points (supp. A.3, O8).
sensor_msgs/Image rgb
sensor_msgs/Image depth
sensor_msgs/CameraInfo camera_info
ObjectModel object
geometry_msgs/Point[] grasp_points   # canonical frame (ProposePoints, kind "grasp")
float64[4] table_plane               # camera frame n (3), d (packet plane): real-gripper check
float64[16] base_t_cam               # capture's camera in base_link, row-major (packet t_base_cam): reachability
float64[6] q                         # capture joints, UR order: reachability
float64 top_down_deg                 # > 0: AnyGrasp approaches within this angle of straight down the table's normal
bool ideal_grasp                     # use the object's hand-set grasp (grasp.IDEAL_GRASPS) if its name has one
---
bool success
string message
geometry_msgs/Pose cam_t_grasp  # grasp frame: x approach, y closing
geometry_msgs/Pose grasp_t_obj  # Phi: grasp -> object canonical (paper Eq. 3)
float64 width
float64 depth
float64 score
int32 n_candidates
int32 n_feasible                     # candidates passing the real-gripper check and near the dots
int32 index
sensor_msgs/Image overlay
